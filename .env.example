# Where the hosted browser build lives, without a trailing slash.
#
# Only the desktop build reads this. A share link is the whole design encoded in a URL hash,
# and a desktop window has no address anyone else can open — so with this unset, the desktop
# build replaces "Copy link" with "Save a copy" rather than handing out a link to
# tauri://localhost that would open nothing.
#
# VITE_WEB_APP_URL=https://wardrobe.studio
