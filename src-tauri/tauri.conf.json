{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Wardrobe Studio",
  "version": "0.1.0",
  "identifier": "studio.wardrobe.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wardrobe Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false,
        "theme": "Dark",
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Wardrobe Studio",
    "category": "DeveloperTool",
    "shortDescription": "Parametric wardrobe configurator with shop-ready output",
    "longDescription": "Design a wardrobe from its parameters and get the panels, drilling positions, sheet layouts, hardware list and a printable shop booklet out of the same model.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["wardrobe"],
        "name": "WardrobeStudioProject",
        "description": "Wardrobe Studio project",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
